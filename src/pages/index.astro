---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TemplateSearch from '../components/TemplateSearch';
import {
  categories,
  generators,
  generatorPath,
  CATEGORY_ICONS,
  accentFor,
} from '../data/registry';
import { iconFor } from '../data/generator-icons';
import { CURRENT_YEAR } from '../lib/site';

const cats = categories();

// The stamp states a fact we can prove: the newest review date in the data.
const lastReviewed = generators
  .map((g) => g.lastReviewed)
  .sort()
  .at(-1)!;
const stamp = new Date(lastReviewed)
  .toLocaleDateString('de-DE', { month: '2-digit', year: 'numeric' })
  .replace('.', '/');

// Flattened via the categories so the list follows the navigation order.
const items = cats.flatMap((cat) =>
  cat.generators.map((g) => ({
    title: g.h1,
    intro: g.intro,
    path: generatorPath(g),
    category: g.category,
    categoryLabel: g.categoryLabel,
    icon: iconFor(g),
    accent: accentFor(g.category),
  })),
);
---

<BaseLayout
  title={`Musterbriefe & Vorlagen ${CURRENT_YEAR}: Kostenlos ausfüllen & drucken`}
  description="Kostenlose Musterbriefe als interaktive Generatoren: Formular ausfüllen, Schreiben drucken oder als PDF speichern – ohne Anmeldung, im Browser."
  path="/"
>
  <div class="sheet px-6 py-8 sm:px-9 sm:py-10">
    <span
      class="float-right ml-4 hidden rotate-[-6deg] rounded border-2 border-stamp px-3 py-1.5 font-display text-[0.8rem] font-semibold tracking-[0.08em] text-stamp uppercase opacity-75 sm:block"
    >
      Muster · geprüft {stamp}
    </span>

    <h1 class="max-w-[18ch] text-3xl font-semibold sm:text-4xl">
      Kostenlose Musterbriefe zum Ausfüllen
    </h1>
    <p class="mt-3 max-w-[56ch] text-ink-soft">
      Wählen Sie eine Vorlage, füllen Sie das Formular aus und drucken Sie das
      fertige Schreiben – oder speichern Sie es als PDF. Alles läuft direkt in
      Ihrem Browser, ohne Anmeldung und ohne Datenübertragung.
    </p>

    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
      <li class="flex items-center gap-2">
        <Icon name="check" class="h-4 w-4 text-stamp" />
        Rechtsgrundlagen geprüft
      </li>
      <li class="flex items-center gap-2">
        <Icon name="check" class="h-4 w-4 text-stamp" />
        Keine Datenübertragung
      </li>
      <li class="flex items-center gap-2">
        <Icon name="check" class="h-4 w-4 text-stamp" />
        {generators.length} Vorlagen, {CURRENT_YEAR} geprüft
      </li>
    </ul>
  </div>

  <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    {
      cats.map((cat) => (
        <li>
          <a
            href={`/${cat.slug}/`}
            class="card-sheet relative block h-full p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
            style={`--accent: ${accentFor(cat.slug)}`}
          >
            <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
            <Icon
              name={CATEGORY_ICONS[cat.slug] ?? 'doc'}
              class="h-6 w-6 text-(--accent)"
            />
            <h2 class="mt-2.5 font-display text-base font-semibold">{cat.label}</h2>
            <p class="mt-0.5 text-[0.8rem] text-ink-mute">
              {cat.generators.length} Vorlagen
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">Alle Musterbriefe</h2>
    <p class="mt-2 max-w-[56ch] text-ink-soft">
      Suchen Sie nach dem Anlass – etwa „Kaution“, „Kündigung“ oder
      „Widerspruch“.
    </p>
    <div class="mt-5">
      <TemplateSearch items={items} groupHeading="h3" client:load />
    </div>
  </section>
</BaseLayout>
