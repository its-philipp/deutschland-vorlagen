---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ExampleLetter from '../../components/ExampleLetter.astro';
import Generator from '../../components/Generator';
import Icon from '../../components/Icon.astro';
import { generators, accentFor } from '../../data/registry';
import { guidesForGenerator, guidePath } from '../../data/guides-registry';
import { relatedFor } from '../../data/related-generators';
import { iconFor } from '../../data/generator-icons';
import type { GeneratorConfig } from '../../lib/generator-config';

export function getStaticPaths() {
  return generators.map((config) => ({
    params: { kategorie: config.category, brief: config.slug },
    props: { config },
  }));
}

interface Props {
  config: GeneratorConfig;
}

const { config } = Astro.props;
const relatedGuides = guidesForGenerator(config.slug);
const related = relatedFor(config);
const lastReviewed = new Date(config.lastReviewed).toLocaleDateString('de-DE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={config.metaTitle}
  description={config.metaDescription}
  path={`/${config.category}/${config.slug}/`}
>
  <div
    class="sheet px-6 py-8 sm:px-9 sm:py-10"
    style={`--accent: ${accentFor(config.category)}`}
  >
    <nav class="text-sm text-ink-mute" aria-label="Brotkrümelnavigation">
      <a href="/" class="hover:text-stamp hover:underline">Startseite</a>
      <span aria-hidden="true"> › </span>
      <a href={`/${config.category}/`} class="hover:text-stamp hover:underline">
        {config.categoryLabel}
      </a>
    </nav>

    <div class="mt-4 flex items-start gap-3">
      <Icon name={iconFor(config)} class="mt-1 h-7 w-7 shrink-0 text-(--accent)" />
      <h1 class="max-w-[22ch] text-3xl font-semibold">{config.h1}</h1>
    </div>
    <p class="mt-3 max-w-[62ch] text-ink-soft">{config.intro}</p>

    {/*
      Steht bewusst ÜBER dem Formular, seit 2026-08-27.
      Vorher öffnete die Seite mit H1, einem Satz und einem leeren Formular —
      wer sie ohne zu tippen ansah (ein Besucher, der erst prüft, ob das das
      richtige Schreiben ist; ein AdSense-Prüfer; ein Crawler-Screenshot), sah
      zwei Bildschirmhöhen Eingabefelder und eine Vorschau aus Platzhalter-
      strichen, bevor der erste erklärende Satz kam. Der Abschnitt stand schon
      da, nur weit unten. Ihn hierher zu ziehen kostet keinen neuen Text und
      beantwortet die Frage, die vor dem Ausfüllen kommt: ist das überhaupt
      mein Fall?
    */}
    <div class="mt-6 border-t border-rule pt-5">
      <h2 class="text-xl font-semibold">Wann brauchen Sie dieses Schreiben?</h2>
      <p class="mt-2 max-w-[68ch] text-ink-soft">{config.explainer.when}</p>
    </div>
  </div>

  <div class="mt-6">
    <Generator config={config} client:load />
  </div>

  <div class="mt-6">
    <Disclaimer />
  </div>

  <ExampleLetter config={config} />

  <section class="sheet mt-6 max-w-none space-y-8 px-6 py-8 sm:px-9 sm:py-10">
    {
      config.explainer.deadline && (
        <div>
          <h2 class="text-xl font-semibold">Welche Frist gilt?</h2>
          <p class="mt-2 max-w-[68ch] text-ink-soft">{config.explainer.deadline}</p>
        </div>
      )
    }

    <div>
      <h2 class="text-xl font-semibold">Rechtsgrundlage</h2>
      <p class="mt-2 max-w-[68ch] text-ink-soft">{config.explainer.legal}</p>
      <ul class="mt-4 space-y-2">
        {
          config.legalBasis.map((ref) => (
            <li class="border-l-[3px] border-stamp/70 bg-stamp-tint/60 px-4 py-3 text-sm">
              <a
                href={ref.url}
                rel="noopener"
                target="_blank"
                class="font-semibold text-stamp hover:underline"
              >
                {ref.ref}
              </a>
              {ref.note && <span class="text-ink-soft"> — {ref.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xl font-semibold">Häufige Fragen</h2>
      <dl class="mt-4 space-y-4">
        {
          config.faq.map((item) => (
            <div class="border-t border-rule pt-4">
              <dt class="font-display font-semibold">{item.q}</dt>
              <dd class="mt-1 max-w-[68ch] text-sm text-ink-soft">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="text-sm text-ink-mute">Stand: {lastReviewed}</p>
  </section>

  {
    related.items.length > 0 && (
      <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
        <h2 class="text-xl font-semibold">Diese Schreiben gehören oft dazu</h2>
        <p class="mt-2 max-w-[68ch] text-ink-soft">{related.note}</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3">
          {related.items.map((item) => (
            <li>
              <a
                href={`/${item.category}/${item.slug}/`}
                style={`--accent: ${accentFor(item.category)}`}
                class="card-sheet relative flex h-full gap-3 p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
              >
                <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
                <Icon name={iconFor(item)} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
                <span class="block">
                  <span class="font-display font-semibold text-ink">{item.h1.split(':')[0]}</span>
                  <span class="mt-1 block text-sm text-ink-mute">{item.categoryLabel}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedGuides.length > 0 && (
      <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
        <h2 class="text-xl font-semibold">Zum Weiterlesen</h2>
        <p class="mt-2 max-w-[68ch] text-ink-soft">
          Fragen, die über diese eine Vorlage hinausgehen — Fristen, Form und
          Zugangsnachweis:
        </p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {relatedGuides.map((guide) => (
            <li>
              <a
                href={guidePath(guide)}
                style="--accent: #2B4C7E"
                class="card-sheet relative flex h-full gap-3 p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
              >
                <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
                <Icon name={guide.icon} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
                <span class="block">
                  <span class="font-display font-semibold text-ink">{guide.h1}</span>
                  <span class="mt-1 block text-sm text-ink-soft">{guide.intro}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
    is:inline
  />
</BaseLayout>
