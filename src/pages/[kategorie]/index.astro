---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Banner from '../../components/Banner.astro';
import { CATEGORY_CONTENT } from '../../data/category-content';
import { iconFor } from '../../data/generator-icons';
import { guides, guidePath } from '../../data/guides-registry';
import {
  categories,
  generatorPath,
  CATEGORY_ICONS,
  accentFor,
  type Category,
} from '../../data/registry';
import { CURRENT_YEAR } from '../../lib/site';

export function getStaticPaths() {
  return categories().map((cat) => ({
    params: { kategorie: cat.slug },
    props: { cat },
  }));
}

interface Props {
  cat: Category;
}

const { cat } = Astro.props;
const content = CATEGORY_CONTENT[cat.slug];
const accent = accentFor(cat.slug);

// Every hub leads into the guides — they answer the questions that sit above
// any single letter (deadline, form, proof of arrival).
const hubGuides = guides.slice(0, 3);
---

<BaseLayout
  title={`${cat.label}: Musterbriefe & Vorlagen ${CURRENT_YEAR}`}
  description={`Kostenlose Musterbriefe zum Thema ${cat.label}: interaktiv ausfüllen, drucken oder als PDF speichern – ohne Anmeldung, direkt im Browser.`}
  path={`/${cat.slug}/`}
>
  <Banner name={cat.slug} />

  <div class="sheet px-6 py-8 sm:px-9 sm:py-10" style={`--accent: ${accent}`}>
    <nav class="text-sm text-ink-mute" aria-label="Brotkrümelnavigation">
      <a href="/" class="hover:text-stamp hover:underline">Startseite</a>
      <span aria-hidden="true"> › </span>
      <span>{cat.label}</span>
    </nav>

    <div class="mt-4 flex items-start gap-3">
      <Icon
        name={CATEGORY_ICONS[cat.slug] ?? 'doc'}
        class="mt-1 h-7 w-7 shrink-0 text-(--accent)"
      />
      <h1 class="text-3xl font-semibold">Musterbriefe: {cat.label}</h1>
    </div>
    {content && <p class="mt-3 max-w-[62ch] text-ink-soft">{content.lead}</p>}
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2" style={`--accent: ${accent}`}>
    {
      cat.generators.map((g) => (
        <li>
          <a
            href={generatorPath(g)}
            class="card-sheet relative flex h-full gap-3 p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
          >
            <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
            <Icon name={iconFor(g)} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
            <span class="block">
              <span class="font-display font-semibold text-ink">{g.h1}</span>
              <span class="mt-1 block text-sm text-ink-soft">{g.intro}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    content && (
      <section class="sheet mt-6 space-y-10 px-6 py-8 sm:px-9 sm:py-10">
        <div>
          <h2 class="text-xl font-semibold">{content.choose.heading}</h2>
          {content.choose.paragraphs.map((p) => (
            <p class="mt-3 max-w-[68ch] text-ink-soft" set:html={p} />
          ))}
        </div>

        <div>
          <h2 class="text-xl font-semibold">{content.essentials.heading}</h2>
          {content.essentials.paragraphs.map((p) => (
            <p class="mt-3 max-w-[68ch] text-ink-soft" set:html={p} />
          ))}
        </div>

        <div style={`--accent: ${accent}`}>
          <h2 class="text-xl font-semibold">{content.mistakes.heading}</h2>
          <dl class="mt-4 space-y-3">
            {content.mistakes.items.map((item) => (
              <div class="border-l-[3px] border-(--accent) bg-folder/60 px-4 py-3">
                <dt class="font-display font-semibold">{item.term}</dt>
                <dd class="mt-1 max-w-[64ch] text-sm text-ink-soft" set:html={item.text} />
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
    <h2 class="text-xl font-semibold">Fragen, die für alle Schreiben gelten</h2>
    <p class="mt-2 max-w-[68ch] text-ink-soft">
      Frist, Form und Zugangsnachweis entscheiden unabhängig vom Thema darüber,
      ob ein Schreiben wirkt. Im Ratgeber steht das einmal ausführlich:
    </p>
    <ul class="mt-4 space-y-2">
      {
        hubGuides.map((guide) => (
          <li class="text-sm">
            <a
              href={guidePath(guide)}
              class="font-semibold text-stamp underline-offset-2 hover:underline"
            >
              {guide.h1}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
