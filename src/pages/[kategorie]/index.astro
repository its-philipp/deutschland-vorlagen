---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORY_INTROS } from '../../data/category-intros';
import { iconFor } from '../../data/generator-icons';
import {
  categories,
  generatorPath,
  CATEGORY_ICONS,
  accentFor,
  type Category,
} from '../../data/registry';
import { CURRENT_YEAR } from '../../lib/site';

export function getStaticPaths() {
  return categories().map((cat) => ({
    params: { kategorie: cat.slug },
    props: { cat },
  }));
}

interface Props {
  cat: Category;
}

const { cat } = Astro.props;
const intro = CATEGORY_INTROS[cat.slug];
const accent = accentFor(cat.slug);
---

<BaseLayout
  title={`${cat.label}: Musterbriefe & Vorlagen ${CURRENT_YEAR}`}
  description={`Kostenlose Musterbriefe zum Thema ${cat.label}: interaktiv ausfüllen, drucken oder als PDF speichern – ohne Anmeldung, direkt im Browser.`}
  path={`/${cat.slug}/`}
>
  <div class="sheet px-6 py-8 sm:px-9 sm:py-10" style={`--accent: ${accent}`}>
    <nav class="text-sm text-ink-mute" aria-label="Brotkrümelnavigation">
      <a href="/" class="hover:text-stamp hover:underline">Startseite</a>
      <span aria-hidden="true"> › </span>
      <span>{cat.label}</span>
    </nav>

    <div class="mt-4 flex items-start gap-3">
      <Icon
        name={CATEGORY_ICONS[cat.slug] ?? 'doc'}
        class="mt-1 h-7 w-7 shrink-0 text-(--accent)"
      />
      <h1 class="text-3xl font-semibold">Musterbriefe: {cat.label}</h1>
    </div>
    {intro && <p class="mt-3 max-w-[62ch] text-ink-soft">{intro}</p>}
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2" style={`--accent: ${accent}`}>
    {
      cat.generators.map((g) => (
        <li>
          <a
            href={generatorPath(g)}
            class="card-sheet relative flex h-full gap-3 p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
          >
            <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
            <Icon name={iconFor(g)} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
            <span class="block">
              <span class="font-display font-semibold text-ink">{g.h1}</span>
              <span class="mt-1 block text-sm text-ink-soft">{g.intro}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
