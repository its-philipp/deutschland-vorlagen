---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Icon from '../../components/Icon.astro';
import { guides, relatedGeneratorsOf } from '../../data/guides-registry';
import { generatorPath, accentFor } from '../../data/registry';
import { iconFor } from '../../data/generator-icons';
import type { GuideConfig } from '../../lib/guide-config';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { beitrag: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideConfig;
}

const { guide } = Astro.props;
const accent = '#2B4C7E';
const related = relatedGeneratorsOf(guide);
const lastReviewed = new Date(guide.lastReviewed).toLocaleDateString('de-DE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  path={`/ratgeber/${guide.slug}/`}
>
  <div class="sheet px-6 py-8 sm:px-9 sm:py-10" style={`--accent: ${accent}`}>
    <nav class="text-sm text-ink-mute" aria-label="Brotkrümelnavigation">
      <a href="/" class="hover:text-stamp hover:underline">Startseite</a>
      <span aria-hidden="true"> › </span>
      <a href="/ratgeber/" class="hover:text-stamp hover:underline">Ratgeber</a>
    </nav>

    <div class="mt-4 flex items-start gap-3">
      <Icon name={guide.icon} class="mt-1 h-7 w-7 shrink-0 text-(--accent)" />
      <h1 class="max-w-[26ch] text-3xl font-semibold">{guide.h1}</h1>
    </div>
    <p class="mt-3 max-w-[62ch] text-ink-soft">{guide.intro}</p>
  </div>

  <article class="sheet mt-6 space-y-10 px-6 py-8 sm:px-9 sm:py-10">
    {
      guide.sections.map((section) => (
        <section>
          <h2 class="text-xl font-semibold">{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p class="mt-3 max-w-[68ch] text-ink-soft" set:html={p} />
          ))}
          {section.list && (
            <dl class="mt-5 space-y-3">
              {section.list.map((item) => (
                <div class="border-l-[3px] border-stamp/70 bg-stamp-tint/60 px-4 py-3">
                  <dt class="font-display font-semibold">{item.term}</dt>
                  <dd
                    class="mt-1 max-w-[64ch] text-sm text-ink-soft"
                    set:html={item.text}
                  />
                </div>
              ))}
            </dl>
          )}
        </section>
      ))
    }

    {
      guide.legalBasis.length > 0 && (
        <section>
          <h2 class="text-xl font-semibold">Die genannten Vorschriften</h2>
          <p class="mt-2 max-w-[68ch] text-ink-soft">
            Jede Angabe ist gegen den amtlichen Text geprüft und verlinkt –
            lesen Sie im Zweifel selbst nach.
          </p>
          <ul class="mt-4 space-y-2">
            {guide.legalBasis.map((ref) => (
              <li class="border-l-[3px] border-stamp/70 bg-stamp-tint/60 px-4 py-3 text-sm">
                <a
                  href={ref.url}
                  rel="noopener"
                  target="_blank"
                  class="font-semibold text-stamp hover:underline"
                >
                  {ref.ref}
                </a>
                {ref.note && <span class="text-ink-soft"> — {ref.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class="text-xl font-semibold">Häufige Fragen</h2>
      <dl class="mt-4 space-y-4">
        {
          guide.faq.map((item) => (
            <div class="border-t border-rule pt-4">
              <dt class="font-display font-semibold">{item.q}</dt>
              <dd class="mt-1 max-w-[68ch] text-sm text-ink-soft">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="text-sm text-ink-mute">Stand: {lastReviewed}</p>
  </article>

  <div class="mt-6">
    <Disclaimer />
  </div>

  {
    related.length > 0 && (
      <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
        <h2 class="text-xl font-semibold">Passende Vorlagen</h2>
        <p class="mt-2 max-w-[68ch] text-ink-soft">
          Diese Generatoren erzeugen die Schreiben, um die es in diesem Beitrag
          geht – ausfüllen, drucken, fertig.
        </p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {related.map((g) => (
            <li>
              <a
                href={generatorPath(g)}
                style={`--accent: ${accentFor(g.category)}`}
                class="card-sheet relative flex h-full gap-3 p-4 pt-5 transition hover:-translate-y-px hover:shadow-sheet"
              >
                <span class="absolute inset-x-4 top-0 h-[3px] bg-(--accent)" />
                <Icon name={iconFor(g)} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
                <span class="block">
                  <span class="font-display font-semibold text-ink">{g.h1}</span>
                  <span class="mt-1 block text-sm text-ink-soft">{g.intro}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
    is:inline
  />
</BaseLayout>
