---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { guides, guidePath } from '../../data/guides-registry';
import { CURRENT_YEAR } from '../../lib/site';

const accent = '#2B4C7E';

/**
 * Auswahlhilfe: die Frage, die jemand tatsächlich im Kopf hat, führt zum
 * Beitrag — nicht der Titel des Beitrags zur Frage.
 *
 * Die Zuordnung steht hier und nicht in `guide-config.ts`, weil sie eine
 * Eigenschaft dieser Seite ist (wie ordne ich die fünf?) und keine des
 * Beitrags. Ein Slug, den es nicht mehr gibt, fällt still heraus, statt einen
 * toten Link zu erzeugen.
 */
const situations = [
  {
    slug: 'widerspruch-einspruch-widerruf',
    question:
      'Ich habe Post bekommen und will nicht einverstanden sein — heißt das jetzt Widerspruch, Einspruch oder Widerruf?',
  },
  {
    slug: 'widerspruch-schreiben',
    question:
      'Es ist ein Widerspruch — aber was schreibe ich hinein, damit er wirkt?',
  },
  {
    slug: 'akteneinsicht-beantragen',
    question:
      'Die Behörde hat entschieden — aber ich sehe nicht, worauf sie sich stützt.',
  },
  {
    slug: 'inkasso-forderung-bestreiten',
    question:
      'Ein Inkassobüro fordert Geld für etwas, das ich nicht zuordnen kann.',
  },
  {
    slug: 'maengel-handwerker-ruegen',
    question:
      'Die Arbeit ist gemacht, aber nicht in Ordnung — und die Rechnung liegt da.',
  },
  {
    slug: 'nachmieter-stellen',
    question:
      'Ich muss früher raus, als die Kündigungsfrist erlaubt.',
  },
  {
    slug: 'fluggastrechte-verspaetung',
    question:
      'Der Flug fiel aus oder kam Stunden zu spät — steht mir dafür etwas zu?',
  },
  {
    slug: 'widerspruchsbescheid-erhalten',
    question:
      'Mein Widerspruch wurde abgelehnt — wie lange habe ich jetzt noch Zeit?',
  },
  {
    slug: 'pkv-beitragserhoehung',
    question:
      'Meine private Krankenversicherung wird schon wieder teurer.',
  },
  {
    slug: 'kuendigungsfristen-uebersicht',
    question:
      'Ich will kündigen und weiß nicht, bis wann das Schreiben draußen sein muss.',
  },
  {
    slug: 'schriftform-textform-kuendigungsbutton',
    question:
      'Reicht eine E-Mail, oder muss ich unterschreiben und per Post schicken?',
  },
  {
    slug: 'schreiben-richtig-versenden',
    question:
      'Ich habe abgeschickt — und die Gegenseite behauptet, nichts erhalten zu haben.',
  },
  {
    slug: 'geschaeftsbrief-din-5008',
    question:
      'Mein Schreiben sieht nicht aus wie ein Brief. Macht das einen Unterschied?',
  },
]
  .map((entry) => ({
    ...entry,
    guide: guides.find((g) => g.slug === entry.slug),
  }))
  .filter((entry) => entry.guide !== undefined);
---

<BaseLayout
  title={`Ratgeber: Fristen, Formen und Versand ${CURRENT_YEAR}`}
  description="Erklärstücke rund um formelle Schreiben: Kündigungsfristen nach Vertragsart, Widerspruch und Einspruch, Schriftform und Zugangsnachweis."
  path="/ratgeber/"
>
  <div class="sheet px-6 py-8 sm:px-9 sm:py-10" style={`--accent: ${accent}`}>
    <nav class="text-sm text-ink-mute" aria-label="Brotkrümelnavigation">
      <a href="/" class="hover:text-stamp hover:underline">Startseite</a>
      <span aria-hidden="true"> › </span>
      <span>Ratgeber</span>
    </nav>

    <div class="mt-4 flex items-start gap-3">
      <Icon name="folder" class="mt-1 h-7 w-7 shrink-0 text-(--accent)" />
      <h1 class="max-w-[24ch] text-3xl font-semibold">Ratgeber</h1>
    </div>
    <p class="mt-3 max-w-[62ch] text-ink-soft">
      Die Fragen, die sich bei fast jedem formellen Schreiben stellen – und die
      keine einzelne Vorlage beantwortet: Welche Frist läuft? Welche Form ist
      nötig? Wie weise ich nach, dass mein Brief angekommen ist?
    </p>
  </div>

  <section class="mt-6 grid gap-4 sm:grid-cols-2" style={`--accent: ${accent}`}>
    {
      guides.map((guide) => (
        <article class="card-sheet relative flex h-full flex-col p-5 pt-6 sm:p-6 sm:pt-7">
          <span class="absolute inset-x-5 top-0 h-[3px] bg-(--accent)" />
          <div class="flex items-start gap-3">
            <Icon name={guide.icon} class="mt-0.5 h-5 w-5 shrink-0 text-(--accent)" />
            <h2 class="font-display text-lg font-semibold text-ink">
              <a href={guidePath(guide)} class="hover:text-stamp hover:underline">
                {guide.h1}
              </a>
            </h2>
          </div>
          <p class="mt-3 grow text-sm text-ink-soft">{guide.intro}</p>
          <p class="mt-4 text-sm">
            <a
              href={guidePath(guide)}
              class="font-semibold text-stamp underline-offset-2 hover:underline"
            >
              Weiterlesen
            </a>
          </p>
        </article>
      ))
    }
  </section>

  <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
    <h2 class="text-xl font-semibold">Welche Frage haben Sie gerade?</h2>
    <p class="mt-2 max-w-[68ch] text-ink-soft">
      Die fünf Beiträge decken die Fragen ab, die vor dem Formulieren kommen.
      Wenn Sie eine davon im Kopf haben, führt sie hier direkt zur Antwort:
    </p>
    <dl class="mt-5 space-y-4">
      {
        situations.map((entry) => (
          <div class="border-l-[3px] border-stamp/70 bg-stamp-tint/60 px-4 py-3">
            <dt class="max-w-[68ch] text-ink">„{entry.question}“</dt>
            <dd class="mt-1 text-sm">
              <a
                href={guidePath(entry.guide!)}
                class="font-semibold text-stamp underline-offset-2 hover:underline"
              >
                {entry.guide!.h1}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
    <h2 class="text-xl font-semibold">
      Drei Dinge entscheiden, ob ein Schreiben etwas bewirkt
    </h2>
    <p class="mt-2 max-w-[68ch] text-ink-soft">
      Wer sich über ein Schreiben ärgert, ärgert sich meist über den Inhalt.
      Wer damit scheitert, scheitert fast nie daran. Es sind drei andere
      Punkte, und alle drei entscheiden sich, bevor der erste Satz steht.
    </p>

    <div class="mt-5 space-y-5">
      <div>
        <h3 class="font-display font-semibold text-ink">
          Die Frist — und ab wann sie läuft
        </h3>
        <p class="mt-1 max-w-[68ch] text-sm text-ink-soft">
          Fast jede Frist in einem formellen Verfahren beginnt nicht mit dem
          Ereignis, über das Sie sich ärgern, sondern mit einem bestimmten
          Zeitpunkt davor oder danach — dem Zugang eines Schreibens, dem Ende
          eines Zeitraums, dem Datum auf einem Bescheid. Wer vom falschen Tag
          aus zählt, ist zu spät, obwohl er sich beeilt hat. Und eine versäumte
          Frist lässt sich in den meisten Verfahren nicht heilen, ein
          unvollständiges Schreiben dagegen nachbessern. Daraus folgt die
          Reihenfolge, die auf dieser Seite immer wieder auftaucht: erst
          absenden, dann beraten lassen.
        </p>
      </div>

      <div>
        <h3 class="font-display font-semibold text-ink">
          Die Form — Papier, Unterschrift oder E-Mail
        </h3>
        <p class="mt-1 max-w-[68ch] text-sm text-ink-soft">
          Für manche Erklärungen genügt eine E-Mail, für andere verlangt das
          Gesetz eine eigenhändige Unterschrift auf Papier, und bei online
          geschlossenen Verbraucherverträgen gibt es inzwischen einen eigenen
          Weg über eine Schaltfläche beim Anbieter. Die falsche Form macht ein
          Schreiben nicht schlechter — sie macht es unwirksam. Deshalb steht
          diese Frage vor der Formulierung und nicht danach.
        </p>
      </div>

      <div>
        <h3 class="font-display font-semibold text-ink">
          Der Zugang — und wer ihn beweisen muss
        </h3>
        <p class="mt-1 max-w-[68ch] text-sm text-ink-soft">
          Entscheidend ist fast nie, wann Sie ein Schreiben abgeschickt haben,
          sondern wann es beim Empfänger angekommen ist. Und beweisen muss das
          in aller Regel derjenige, der sich auf das Schreiben beruft — also
          Sie. Genau hier gehen Auseinandersetzungen aus, die inhaltlich längst
          entschieden wären: Die Gegenseite sagt schlicht, sie habe nichts
          erhalten. Welcher Versandweg was belegt und was ein Einschreiben
          tatsächlich beweist, ist deshalb keine Formalie.
        </p>
      </div>
    </div>

    <p class="mt-5 max-w-[68ch] text-sm text-ink-mute">
      Die Beiträge oben gehen auf diese drei Punkte im Einzelnen ein und nennen
      die Vorschriften, auf die es dabei ankommt, mit Link auf den amtlichen
      Wortlaut.
    </p>
  </section>

  <section class="sheet mt-6 px-6 py-8 sm:px-9 sm:py-10">
    <h2 class="text-xl font-semibold">Wozu ein Ratgeber, wenn es Vorlagen gibt?</h2>
    <p class="mt-2 max-w-[68ch] text-ink-soft">
      Eine Vorlage beantwortet die Frage „Wie formuliere ich das?“. Sie
      beantwortet nicht die Fragen, die davor kommen: ob das Schreiben
      überhaupt das richtige ist, bis wann es da sein muss und in welcher Form
      es zugehen muss, damit es wirkt. Genau diese Fragen entscheiden aber
      darüber, ob ein perfekt formuliertes Schreiben etwas bewirkt oder nicht.
    </p>
    <p class="mt-3 max-w-[68ch] text-ink-soft">
      Deshalb steht hier, was für viele Vorlagen zugleich gilt – einmal
      ausführlich erklärt, statt auf 35 Seiten in Halbsätzen. Jeder Beitrag
      verlinkt am Ende die Vorlagen, um die es dabei geht.
    </p>
  </section>
</BaseLayout>
