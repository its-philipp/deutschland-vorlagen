---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_NAME_PARTS,
  GITHUB_REPO,
  CURRENT_YEAR,
  absoluteUrl,
} from '../lib/site';
import { ADS_ENABLED, ADSENSE_CLIENT } from '../lib/ads';
import { categories, CATEGORY_NAV_LABELS, accentFor } from '../data/registry';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  /** Unique per page — targets the page's one keyword. */
  title: string;
  /** Unique per page, ~150 chars. */
  description: string;
  /** Path starting with '/', used for canonical + og:url. */
  path: string;
  /** Set true for legal/utility pages that should not be indexed. */
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
const canonical = absoluteUrl(path);

// The register tab of the section the visitor is in — first path segment.
const activeCategory = path.split('/')[1] ?? '';
const navCategories = categories();

// "Fehler melden" carries the page it was clicked on, so a report is
// actionable without asking back — GitHub issue forms prefill by field id.
// The template's chooser offers kontakt@ for anything that should not be
// public, so the non-technical route stays open.
const reportUrl =
  `${GITHUB_REPO}/issues/new?template=fehler-in-einer-vorlage.yml` +
  `&seite=${encodeURIComponent(absoluteUrl(path))}`;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="de_DE" />
    {
      /* AdSense. The tag carries Google's certified CMP, which gates ad
         storage on consent (§ 25 Abs. 1 TDDDG) before any ad is served. */
      ADS_ENABLED && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen bg-folder font-sans text-ink antialiased">
    <IconSprite />

    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:bg-paper focus:px-3 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Zum Inhalt springen
    </a>

    <header>
      <div class="mx-auto max-w-5xl px-4 pt-5">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
          <a
            href="/"
            class="font-display text-[1.45rem] font-semibold tracking-tight text-ink"
          >
            {SITE_NAME_PARTS[0]}<span class="text-stamp">{SITE_NAME_PARTS[1]}</span>
          </a>
          <p class="text-sm text-ink-soft">
            Musterbriefe ausfüllen, drucken, fertig
          </p>
        </div>

        <!-- Register tabs: the two-level navigation, second level. -->
        <nav
          id="kategorie-tabs"
          class="mt-4 flex gap-1 overflow-x-auto pt-1"
          aria-label="Kategorien"
        >
          {
            navCategories.map((cat) => {
              const current = activeCategory === cat.slug;
              return (
                <a
                  href={`/${cat.slug}/`}
                  aria-current={current ? 'page' : undefined}
                  style={`--accent: ${accentFor(cat.slug)}`}
                  class:list={[
                    'shrink-0 rounded-t-[7px] border-t-[3px] px-4 py-2 text-[0.8125rem] whitespace-nowrap transition',
                    current
                      ? 'border-(--accent) bg-paper font-semibold text-ink'
                      : 'border-transparent bg-folder-deep text-ink-soft hover:border-(--accent) hover:bg-[#d5dcd6] hover:text-ink',
                  ]}
                >
                  {CATEGORY_NAV_LABELS[cat.slug] ?? cat.label}
                </a>
              );
            })
          }
          {
            /* Sixth tab, not a category: the guides are the part of the site
               that is not a form. Same tab mechanics, brand accent. */
          }
          <a
            href="/ratgeber/"
            aria-current={activeCategory === 'ratgeber' ? 'page' : undefined}
            style="--accent: #2B4C7E"
            class:list={[
              'shrink-0 rounded-t-[7px] border-t-[3px] px-4 py-2 text-[0.8125rem] whitespace-nowrap transition',
              activeCategory === 'ratgeber'
                ? 'border-(--accent) bg-paper font-semibold text-ink'
                : 'border-transparent bg-folder-deep text-ink-soft hover:border-(--accent) hover:bg-[#d5dcd6] hover:text-ink',
            ]}
          >
            Ratgeber
          </a>
        </nav>
      </div>
    </header>

    {
      /* On narrow screens the tab row scrolls; without this the visitor's own
         section can sit off-screen. Set scrollLeft rather than calling
         scrollIntoView, which would also move the page vertically. */
    }
    <script is:inline>
      (() => {
        const nav = document.getElementById('kategorie-tabs');
        const current = nav?.querySelector('[aria-current="page"]');
        if (nav && current) nav.scrollLeft = current.offsetLeft - 16;
      })();
    </script>

    <main id="inhalt" class="mx-auto max-w-5xl px-4 pb-14">
      <slot />
    </main>

    <footer class="mt-4 border-t border-rule">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-7 text-sm text-ink-soft"
      >
        <p class="max-w-2xl">
          Alle Muster sind Vorlagen zum Selbst-Ausfüllen und keine
          Rechtsberatung. Alle Angaben ohne Gewähr.
        </p>
        <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Rechtliches">
          <a href="/ueber-uns/" class="hover:text-stamp hover:underline">
            Über uns
          </a>
          <a href="/ratgeber/" class="hover:text-stamp hover:underline">
            Ratgeber
          </a>
          <a href="/kontakt/" class="hover:text-stamp hover:underline">
            Kontakt
          </a>
          <a href="/impressum/" class="hover:text-stamp hover:underline">
            Impressum
          </a>
          <a href="/datenschutz/" class="hover:text-stamp hover:underline">
            Datenschutz
          </a>
          <a
            href={reportUrl}
            rel="noopener"
            target="_blank"
            class="hover:text-stamp hover:underline"
          >
            Fehler melden
          </a>
          <a
            href={GITHUB_REPO}
            rel="noopener"
            target="_blank"
            class="hover:text-stamp hover:underline"
          >
            Quellcode
          </a>
        </nav>
        <p>© {CURRENT_YEAR} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
